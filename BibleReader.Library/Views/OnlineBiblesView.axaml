<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:BibleReader.Library"
             xmlns:local="using:BibleReader.Library.UI"
             x:Class="BibleReader.Library.UI.OnlineBiblesView"
             x:DataType="local:OnlineBiblesView">

    <UserControl.Resources>
        <!-- One row of a list of Bibles: used by the installed Bibles and by the online ones. -->
        <DataTemplate x:Key="BibleRow" x:DataType="local:OnlineBibleItem">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4">
                <!-- The cover of the Bible, if one was found (BibliaLibreBible.GetImagesAsync). -->
                <Image Source="{Binding Cover}" Width="80" Height="112" Stretch="Uniform" Margin="0,0,8,0"
                       VerticalAlignment="Center" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <!-- Hovering the cover pops it up at three times the size (80x112 -> 240x336). -->
                    <ToolTip.Tip>
                        <Image Source="{Binding Cover}" Width="240" Height="336" Stretch="Uniform" />
                    </ToolTip.Tip>
                </Image>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Bible.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" FontSize="{loc:Size 12}" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Error}" FontSize="{loc:Size 12}" Foreground="OrangeRed"
                               IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <local:BusySpinner Width="20" Height="20" Thickness="3" IsVisible="{Binding IsBusy}" />
                    <!-- The check mark keeps the colours of its file. -->
                    <loc:ThemedSvg Path="/Assets/circle-check.svg" Size="18" ThemeColor="False" IsVisible="{Binding IsInstalled}"
                                   ToolTip.Tip="{loc:Loc Installed}" />
                    <TextBlock Text="{loc:Loc Installed}" Opacity="0.7" VerticalAlignment="Center"
                               IsVisible="{Binding IsInstalledAndWide}" />
                    <Button Click="OnInstallClick" IsVisible="{Binding CanInstall}">
                        <StackPanel Orientation="Horizontal">
                            <loc:ThemedSvg Path="/Assets/download.svg" Size="18" ToolTip.Tip="{loc:Loc Install}" />
                            <TextBlock Text="{loc:Loc Install}" Margin="4,0,0,0"
                                IsVisible="{Binding $parent[local:OnlineBiblesView].IsWide}" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnDeleteClick"
                            IsVisible="{Binding CanDelete}">
                        <StackPanel Orientation="Horizontal">
                            <loc:ThemedSvg Path="/Assets/trash.svg" Size="18" ToolTip.Tip="{loc:Loc Delete}" />
                            <TextBlock Text="{loc:Loc Delete}" Margin="4,0,0,0"
                                IsVisible="{Binding $parent[local:OnlineBiblesView].IsWide}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsConfirmingDelete}">
                        <Button Content="{loc:Loc DeleteQuestion}" Click="OnConfirmDeleteClick" Foreground="OrangeRed" />
                        <Button Content="{loc:Loc Cancel}" Click="OnCancelDeleteClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <!-- The Bibles that are installed already, at the top. The header shows the count; the right margin keeps the
             close button free. -->
        <Expander x:Name="InstalledExpander" Grid.Row="0" Margin="12,8,52,20" HorizontalAlignment="Stretch" IsExpanded="False">
            <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="InstalledHeader" Text="{loc:Loc InstalledBibles}" VerticalAlignment="Center" />
                    <!-- Installs a Bible from a zip, 7z or xml file on this device. -->
                    <Button x:Name="InstallFromFileButton" Grid.Column="1" Click="OnInstallFromFileClick"
                        ToolTip.Tip="{loc:Loc InstallFromFile}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <loc:ThemedSvg Path="/Assets/upload.svg" Size="18" />
                            <TextBlock Text="{loc:Loc InstallFromFile}" VerticalAlignment="Center"
                                IsVisible="{Binding $parent[local:OnlineBiblesView].IsWide}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Expander.Header>
            <ListBox x:Name="InstalledList" MaxHeight="250" Background="Transparent"
                     ItemTemplate="{StaticResource BibleRow}" />
        </Expander>

        <!-- Filter bar for the online Bibles: language and free text. -->
        <StackPanel Grid.Row="1" Margin="12,8" Spacing="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="LanguageBox" MinWidth="200" IsEditable="True" SelectionChanged="OnLanguageChanged"
                    PlaceholderText="{loc:Loc LanguagePlaceholder}"/>
                <!-- The filter icon is a button: it opens the list of the kinds of modules (InstallableBook.Classes). -->
                <Button x:Name="ClassButton" Grid.Column="1" Padding="8,6" BorderThickness="0" Background="Transparent"
                        Cursor="Hand" ToolTip.Tip="{loc:Loc FilterByKind}" Click="OnClassFilterClick">
                    <loc:ThemedSvg Path="/Assets/filter.svg" Size="18" />
                </Button>
                <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="{loc:Loc SearchNamePlaceholder}" TextChanged="OnSearchChanged" />
                <Button Grid.Column="3" Click="OnReloadClick" ToolTip.Tip="{loc:Loc Reload}">
                    <loc:ThemedSvg Path="/Assets/cycle.svg" Size="18" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- The kinds of modules to show; its entries are added in code. -->
        <Popup x:Name="ClassPopup" Grid.Row="1" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True"
               Closed="OnClassPopupClosed">
            <Border MinWidth="180" Padding="8,4" BorderThickness="1" CornerRadius="6"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <!-- Toggle: choosing the chosen kind again clears the filter. -->
                <ListBox x:Name="ClassList" SelectionMode="Toggle" Background="Transparent"
                         SelectionChanged="OnClassSelectionChanged" />
            </Border>
        </Popup>

        <SelectableTextBlock x:Name="StatusText" Grid.Row="2" Margin="12,0,12,6" Opacity="0.7" TextWrapping="Wrap" />

        <ListBox x:Name="List" Grid.Row="3" Background="Transparent" ItemTemplate="{StaticResource BibleRow}" />

        <local:BusySpinner x:Name="LoadSpinner" Grid.Row="3" Width="40" Height="40"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />

        <!-- Asks for the name of a Bible installed from a file; it covers the whole view. -->
        <Border x:Name="NamePanel" Grid.RowSpan="4" IsVisible="False" Background="#80000000">
            <Border MaxWidth="400" Margin="16" Padding="16" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc NameOfBible}" FontWeight="SemiBold" />
                    <TextBox x:Name="NameBox" KeyDown="OnNameKeyDown" />
                    <TextBlock x:Name="NameError" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="False" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Install}" Click="OnNameOkClick" />
                        <Button Content="{loc:Loc Cancel}" Click="OnNameCancelClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Asks whether Christians are persecuted in the reader's country, when no Bible is installed yet and the
             answer is not known: the online Bibles are only listed where there is no persecution. -->
        <Border x:Name="PersecutionPanel" Grid.RowSpan="4" IsVisible="False" Background="#80000000">
            <Border MaxWidth="400" Margin="16" Padding="16" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc PersecutionQuestion}" TextWrapping="Wrap" />
                    <StackPanel Spacing="8">
                        <Button Content="{loc:Loc PersecutionYes}" Click="OnPersecutionYesClick" HorizontalAlignment="Stretch" />
                        <Button Content="{loc:Loc PersecutionNo}" Click="OnPersecutionNoClick" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Back to reading, in the upper right corner. -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                Padding="8,6" Background="Transparent" BorderThickness="0"
                ToolTip.Tip="{loc:Loc Close}" Click="OnCloseClick">
            <loc:ThemedSvg Path="/Assets/close.svg" Size="18" />
        </Button>
    </Grid>
</UserControl>
